# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
pip-wheel-metadata/
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.spec
/dist/
/build/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environment
venv/
ENV/
env/
.venv/
venv.bak/

# Pyenv
.python-version

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Test and coverage
.pytest_cache/
.coverage
coverage.xml

# Logs and databases
*.log
*.sqlite3

# Credentials and environment variables
.env
.env.local
.env.*

# Pillow cache
__pycache__/

# Distribution artifacts
*.exe
*.dll
*.manifest

# Misc
*.bak
*.swp
*.tmp

# Ignore user-specific files
*.local

# Ignore built executable folder if created by build script
dist/
